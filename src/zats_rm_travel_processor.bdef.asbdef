projection;
strict ( 2 );

define behavior for ZATS_RM_TRAVEL_PROCESSOR alias Travel
{
  use create;
  use update;
  use delete;

  use association _Booking { create; }
}

define behavior for ZATS_RM_BOOKING_PROCESSOR alias Booking
{
  use update;
  use delete;

  use association _Travel;
  use association _Supplement { create; }
}

define behavior for ZATS_RM_SUPPL_PROCESSOR alias Supplement
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}