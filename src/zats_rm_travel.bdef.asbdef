//managed tells RAP that developer want it to create most of the code automatically
managed
//to plugin extra coding/validatio,  this is where we do it
implementation in class zbp_ats_rm_travel unique;
//to syntax check strictly: 1 or 2; 2 is more strict
strict ( 2 );
//root entity behaviour
define behavior for zats_rm_travel alias Travel
//what behaviour CUD into which table
persistent table /dmo/travel_m
//similar to enqueue and dequeue
lock master
//for data security- authorizations to do CUD, this part of coding goes into implementation class mentioned above
authorization master ( instance )
//controls the behaviour of multiple users editing simultaneously using timestamp field
etag master LastChangedAt
early numbering
{
//behaviours RAP generate code for us
  create;
  update;
  delete;
  //feature control so user dont change the PK in update mode
  field ( readonly ) TravelId;
//  field ( numbering : managed ) TravelId;

//depends on travel, cannot exist on its own
  association _Booking { create; }

  mapping for /dmo/travel_m {
  TravelId = travel_id;
  TotalPrice = total_price;
  AgencyId = agency_id;
//  AgencyName = name;
  CustomerId = customer_id;
  BeginDate = begin_date;
  EndDate = end_date;
  BookingFee = booking_fee;
  CurrencyCode = currency_code;
  LastChangedAt = last_changed_at;
  LastChangedBy = last_changed_by;
  CreatedAt = created_at;
  CreatedBy = created_by;
  Description = description;
  OverallStatus = overall_status;
  }
}

define behavior for zats_rm_booking alias Booking
persistent table /dmo/booking_m
//if parent is locked,child also gets locked
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
early numbering
{
//  create;
  update;
  delete;
  //when booking is edited, travel cannot be changed
  field ( readonly ) TravelId;
  association _Travel;
  association _Supplement { create; }

  mapping for /dmo/booking_m {
  TravelId = travel_id;
  BookingId = booking_id;
  BookingDate = booking_date;
  BookingStatus = booking_status;
  CustomerId = customer_id;
  CarrierId = carrier_id;
  ConnectionId = connection_id;
  FlightDate = flight_date;
  FlightPrice = flight_price;
  CurrencyCode = currency_code;
  LastChangedAt = last_changed_at;
  }
}

define behavior for zats_rm_suppl alias Supplement
persistent table /dmo/booksuppl_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId;
  association _Travel;
  association _Booking;

  mapping for /dmo/booksuppl_m {
  TravelId =  travel_id;
  BookingId = booking_id;
  BookingSupplementId = booking_supplement_id;
  SupplementId = supplement_id;
  Price = price;
  CurrencyCode = currency_code;
  LastChangedAt = last_changed_at;

  }
}